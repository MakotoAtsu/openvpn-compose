# Copy this file to .env and adjust. Docker Compose reads .env automatically.
# Values are plain text: no quotes needed.

# Address clients use to reach this server (a DNS name or an IP).
# Written into every client profile as the "remote" line. REQUIRED.
VPN_HOST=

# UDP port the server listens on and publishes on the host.
VPN_PORT=1194

# Private network handed out to connected clients (CIDR).
# Must not overlap with any network on either end of the tunnel
# (the server's own networks, Docker networks, the client's LAN).
VPN_SUBNET=172.16.88.0/24

# DNS servers pushed to clients, comma separated. Leave empty to push none.
VPN_DNS=1.1.1.1,1.0.0.1

# true  = clients send ALL traffic through the VPN (the server becomes their exit).
# false = clients only send traffic for the VPN network through the tunnel.
VPN_REDIRECT_GATEWAY=true

# One certificate and profile (data/clients/<name>.ovpn) per name, comma separated.
# Allowed characters: letters, digits, "-" and "_". Use one name per device.
VPN_CLIENTS=vpn-client

# Validity in days for newly issued certificates (CA, server, clients).
# Keep the expiry before 2038: older 32-bit clients may mishandle later dates.
VPN_CERT_DAYS=3650
